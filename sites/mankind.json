{
  "_help": "Mankind UK recipe (THG platform). Browsing only, never an order. Built 2026-11-16 from a probe of the live site.",
  "site_name": "Mankind UK",
  "url": "https://www.mankind.co.uk",
  "gtm_loader_patterns": [
    "googletagmanager\\.com/gtm\\.js"
  ],
  "cookie_banner_accept": [
    "#onetrust-accept-btn-handler"
  ],
  "cookie_banner_reject": [
    "#onetrust-reject-all-handler"
  ],
  "product_index": 0,
  "noise_events": [],
  "journey": [
    {
      "name": "Category",
      "action": "goto",
      "url": "{base_url}/c/health-beauty/haircare/view-all-hair/"
    },
    {
      "name": "Product",
      "action": "click_random",
      "selector": "a.product-item[href*='/p/']"
    },
    {
      "name": "Add to basket",
      "action": "click",
      "selector": "#add-to-basket"
    },
    {
      "name": "Basket",
      "action": "goto",
      "url": "{base_url}/basket/"
    },
    {
      "name": "Checkout",
      "action": "click",
      "selector": "#summary-checkout-btn"
    }
  ]
}
