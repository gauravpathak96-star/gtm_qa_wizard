{
  "_help": "LOOKFANTASTIC UK recipe. Used to develop and test gtm-qa-wizard (browsing only, no order). The runner opens url from the release file.",
  "site_name": "LOOKFANTASTIC UK",
  "url": "https://www.lookfantastic.com",
  "gtm_loader_patterns": [
    "googletagmanager\\.com/gtm\\.js"
  ],
  "cookie_banner_accept": [
    "#onetrust-accept-btn-handler",
    "button:has-text('Accept All Cookies')"
  ],
  "wait_s": 8,
  "full_page_screenshots": false,
  "cookies": [
    "_ga",
    "_fbp",
    "_fbc",
    "_gcl_au",
    "OptanonConsent"
  ],
  "journey": [
    {
      "name": "Home",
      "action": "goto",
      "url": "{base_url}/"
    },
    {
      "name": "Category",
      "action": "goto",
      "url": "{base_url}/c/health-beauty/face/"
    },
    {
      "name": "Product",
      "action": "click_random",
      "selector": "a[data-astro-prefetch='viewport'][href*='/p/']"
    },
    {
      "name": "Add to basket",
      "action": "click",
      "selector": "#add-to-basket"
    },
    {
      "name": "Basket",
      "action": "goto",
      "url": "{base_url}/basket/"
    },
    {
      "name": "Checkout",
      "action": "click",
      "selector": "#summary-checkout-btn"
    }
  ],
  "cookie_banner_reject": [
    "#onetrust-reject-all-handler",
    "button:has-text('Reject All')"
  ],
  "_noise_help": "Events a noise test (gtm-qa run <release> preview --without-workspace) showed differ between two identical runs. Left out of every report for this site and listed under Not compared. Format: \"Vendor:event\".",
  "noise_events": [
    "GA4:ring_icon_viewed"
  ],
  "_guest_checkout_help": "Used when the release file has guest_checkout_email: at Checkout the email is typed into the guest form, marketing is declined if asked, and Continue as guest is clicked.",
  "guest_checkout": {
    "email": "#guestEmail",
    "decline_marketing": "input[id*='I_DO_NOT_CONSENT']",
    "continue": "button:has-text('Continue as guest')"
  }
}
